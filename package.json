{
  "name": "powersol-backend",
  "version": "0.1.0",
  "description": "PowerSOL backend services and on-chain integration",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc --project tsconfig.build.json",
    "start": "node dist/server.js",
    "lint": "eslint . --ext .ts",
    "test": "jest",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "jobs": "ts-node src/jobs/runAll.ts",
    "queue": "ts-node src/queues/worker.ts",
    "seed:tiers": "ts-node scripts/seedAffiliateTiers.ts",
    "seed:missions": "ts-node scripts/seedMissions.ts",
    "draw:once": "ts-node scripts/runDrawOnce.ts",
    "seed:all": "ts-node scripts/seedAll.ts"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.29.0",
    "@metaplex-foundation/js": "^0.20.0",
    "@metaplex-foundation/mpl-bubblegum": "^0.7.0",
    "@metaplex-foundation/mpl-token-metadata": "^2.11.0",
    "@prisma/client": "^5.7.0",
    "@solana/spl-token": "^0.3.8",
    "@solana/web3.js": "^1.95.4",
    "@switchboard-xyz/solana.js": "^3.2.0",
    "@types/jsonwebtoken": "^9.0.10",
    "axios": "^1.6.2",
    "bs58": "^6.0.0",
    "bullmq": "^5.5.0",
    "commander": "^11.1.0",
    "cors": "^2.8.5",
    "date-fns": "^3.6.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^7.0.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "node-cron": "^3.0.2",
    "pino": "^8.15.0",
    "pino-pretty": "^10.2.0",
    "superstruct": "^1.0.3",
    "tweetnacl": "^1.0.3",
    "uuid": "^9.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.3",
    "@types/morgan": "^1.9.10",
    "@types/node": "^20.10.4",
    "@types/node-cron": "^3.0.11",
    "@types/supertest": "^2.0.13",
    "eslint": "^8.54.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-import": "^2.29.0",
    "jest": "^29.7.0",
    "prisma": "^5.7.0",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}